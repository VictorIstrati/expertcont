---
import NavWithSwitcher from "./NavWithSwitcher";
import FooterIsland from "./FooterIsland";
import CookieBanner from "./CookieBanner";
import ModalsHost from "./modals/ModalsHost";
import { sectionUrl, type Locale } from "@expertcont/i18n";
import type { NavSection } from "@expertcont/ui";
import { site, addressShort } from "../site";

interface Props {
  locale: Locale;
  activeSection?: NavSection;
  /** Sibling URLs per locale for the locale switcher. */
  siblings: Record<Locale, string>;
  /** Shows a language as current that the switcher does not offer, e.g. Ukrainian. */
  displayLang?: { label: string; full: string };
}

const { locale, activeSection, siblings, displayLang } = Astro.props;
const cookiePolicyHref = sectionUrl("cookies", locale);
---

<NavWithSwitcher
  client:load
  locale={locale}
  activeSection={activeSection}
  siblings={siblings}
  displayLang={displayLang}
/>
<main id="page-content">
  <slot />
</main>
<FooterIsland
  client:idle
  locale={locale}
  address={addressShort(locale)}
  phone={site.business.phone}
  email={site.business.email}
/>
<CookieBanner client:idle locale={locale} policyHref={cookiePolicyHref} />
<ModalsHost client:idle locale={locale} />
