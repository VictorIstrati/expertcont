---
import { Container, Icon, Section } from "@expertcont/ui";
import { localeTag, type Locale } from "@expertcont/i18n";
import {
  BASE_RATES_CHECKED,
  LIMITATION_YEARS,
  STATUTORY_MARGIN,
  baseRateOn,
} from "./baseRates";

interface Props {
  locale: Locale;
  legalHref: string;
}

const { locale, legalHref } = Astro.props;
const pf = new Intl.NumberFormat(localeTag(locale), {
  style: "percent",
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const df = new Intl.DateTimeFormat(localeTag(locale), {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const checked = df.format(new Date(`${BASE_RATES_CHECKED}T00:00:00Z`));
const b2b = Math.round(STATUTORY_MARGIN.business * 100);
const b2c = Math.round(STATUTORY_MARGIN.consumer * 100);

const semesters: { year: number; half: 1 | 2; base: number }[] = [];
for (let year = 2020; ; year++) {
  const h1 = `${year}-01-01`;
  if (h1 > BASE_RATES_CHECKED) break;
  semesters.push({ year, half: 1, base: baseRateOn(h1) });
  const h2 = `${year}-07-01`;
  if (h2 > BASE_RATES_CHECKED) break;
  semesters.push({ year, half: 2, base: baseRateOn(h2) });
}
semesters.reverse();

interface Copy {
  basisEyebrow: string;
  basisTitle: string;
  statutoryTitle: string;
  statutoryBody: string;
  statutoryItems: string[];
  contractualTitle: string;
  contractualBody: string;
  contractualItems: string[];
  ratesEyebrow: string;
  ratesTitle: string;
  ratesBody: string;
  semesterCol: string;
  baseCol: string;
  b2bCol: string;
  b2cCol: string;
  half: Record<1 | 2, string>;
  ratesNote: string;
  letterEyebrow: string;
  letterTitle: string;
  letterSteps: { title: string; body: string }[];
  limitationTitle: string;
  limitationBody: string;
  ctaTitle: string;
  ctaBody: string;
  ctaLink: string;
}

const copy: Record<Locale, Copy> = {
  ro: {
    basisEyebrow: "Temeiul legal",
    basisTitle: "Dobânda legală sau penalitatea din contract",
    statutoryTitle: "Dobânda de întârziere (art. 942 Cod civil)",
    statutoryBody:
      "Se datorează automat pentru orice sumă de bani neplătită la scadență, chiar dacă contractul nu spune nimic despre întârziere.",
    statutoryItems: [
      `rata = rata de bază a BNM + ${b2b} puncte procentuale pe an, dacă debitorul nu este consumator (o companie, un profesionist sau o persoană fizică datoare altei persoane fizice)`,
      `rata = rata de bază a BNM + ${b2c} puncte procentuale pe an, dacă debitorul este consumator`,
      "rata de bază se ia pe semestre: cea în vigoare la 1 ianuarie pentru ianuarie–iunie și cea în vigoare la 1 iulie pentru iulie–decembrie (art. 874 alin. (2))",
      "curge din ziua imediat următoare scadenței până în ziua plății inclusiv",
      "dacă suma purta dobândă contractuală, creditorul poate folosi acea dobândă în locul ratei de bază",
      "dacă neplata la scadență este justificată, se datorează doar rata de bază, iar consumatorul nu datorează dobândă de întârziere (art. 942 alin. (5))",
      "între profesioniști, creditorul poate cere în plus o despăgubire minimă egală cu echivalentul în lei a 40 de euro pentru cheltuielile de recuperare (art. 945)",
    ],
    contractualTitle: "Penalitatea contractuală (clauza penală)",
    contractualBody:
      "Se aplică doar dacă părțile au convenit-o în contract — de obicei un procent pe zi de întârziere, uneori cu un plafon.",
