const t = copy[locale];
---

<Section tone="default">
  <Container>
    <div class="text-center mb-10">
      <div class="eyebrow mb-4 justify-center">{t.basisEyebrow}</div>
      <h2 class="mb-0">{t.basisTitle}</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      <div class="card p-6 sm:p-7 border-accent">
        <div class="flex items-center gap-3 mb-4">
          <div
            class="w-12 h-12 rounded-lg bg-accent-50 text-accent-dark flex items-center justify-center shrink-0"
          >
            <Icon name="scale" size={24} />
          </div>
          <h3 class="text-lg mb-0">{t.statutoryTitle}</h3>
        </div>
        <p class="text-text-secondary leading-relaxed mb-4">{t.statutoryBody}</p>
        <ul class="list-none p-0 m-0 flex flex-col gap-2">
          {
            t.statutoryItems.map((item) => (
              <li class="flex items-start gap-2 text-sm sm:text-base">
                <span class="text-accent-dark shrink-0 mt-0.5">
                  <Icon name="check" size={18} />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card p-6 sm:p-7">
        <div class="flex items-center gap-3 mb-4">
          <div
            class="w-12 h-12 rounded-lg bg-primary-50 text-primary flex items-center justify-center shrink-0"
          >
            <Icon name="file-text" size={24} />
          </div>
          <h3 class="text-lg mb-0">{t.contractualTitle}</h3>
        </div>
        <p class="text-text-secondary leading-relaxed mb-4">{t.contractualBody}</p>
        <ul class="list-none p-0 m-0 flex flex-col gap-2">
          {
            t.contractualItems.map((item) => (
              <li class="flex items-start gap-2 text-sm sm:text-base">
                <span class="text-primary shrink-0 mt-0.5">
                  <Icon name="chevron-right" size={18} />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</Section>

<Section tone="alt">
  <Container>
    <div class="grid gap-8 grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] items-start">
      <div>
        <div class="eyebrow mb-4">{t.ratesEyebrow}</div>
        <h2 class="mb-3">{t.ratesTitle}</h2>
        <p class="text-text-secondary leading-relaxed mb-6">{t.ratesBody}</p>
        <div class="card p-0 overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="text-[11px] font-bold tracking-widest uppercase text-text-secondary">
                <th class="text-left px-5 py-3">{t.semesterCol}</th>
                <th class="text-right px-3 py-3">{t.baseCol}</th>
                <th class="text-right px-3 py-3">{t.b2bCol}</th>
                <th class="text-right px-5 py-3">{t.b2cCol}</th>
              </tr>
            </thead>
            <tbody>
              {
                semesters.map((s) => (
                  <tr class="border-t border-border">
                    <th scope="row" class="text-left font-semibold px-5 py-2.5 whitespace-nowrap">
                      {s.year} · {t.half[s.half]}
                    </th>
                    <td class="text-right px-3 py-2.5 whitespace-nowrap">{pf.format(s.base)}</td>
                    <td class="text-right px-3 py-2.5 font-bold whitespace-nowrap">
                      {pf.format(s.base + STATUTORY_MARGIN.business)}
                    </td>
                    <td class="text-right px-5 py-2.5 whitespace-nowrap">
                      {pf.format(s.base + STATUTORY_MARGIN.consumer)}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-sm text-text-secondary leading-relaxed mt-4 mb-0">{t.ratesNote}</p>
      </div>
      <div class="flex flex-col gap-5 lg:mt-[88px]">
        <div class="card p-6 sm:p-7">
          <div
            class="w-12 h-12 rounded-lg bg-primary-50 text-primary flex items-center justify-center mb-4"
          >
            <Icon name="clock" size={24} />
          </div>
          <h3 class="text-lg mb-2">{t.limitationTitle}</h3>
          <p class="text-text-secondary leading-relaxed mb-0">{t.limitationBody}</p>
        </div>
      </div>
    </div>
  </Container>
</Section>

<Section tone="default">
  <Container>
    <div class="text-center mb-10">
      <div class="eyebrow mb-4 justify-center">{t.letterEyebrow}</div>
      <h2 class="mb-0">{t.letterTitle}</h2>
    </div>
    <ol class="list-none p-0 m-0 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.letterSteps.map((step, i) => (
          <li class="card p-6">
            <div class="w-10 h-10 rounded-full bg-accent text-[#1A1A2E] font-extrabold flex items-center justify-center mb-4">
              {i + 1}
            </div>
            <h3 class="text-base mb-2">{step.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed mb-0">{step.body}</p>
          </li>
        ))
      }
    </ol>
    <div
      class="card p-6 sm:p-8 mt-8 flex flex-col md:flex-row md:items-center justify-between gap-5 border-accent"
    >
      <div class="flex items-start gap-4">
        <div
          class="w-12 h-12 rounded-lg bg-accent-50 text-accent-dark flex items-center justify-center shrink-0"
        >
          <Icon name="shield" size={24} />
        </div>
        <div>
          <h3 class="text-lg mb-1">{t.ctaTitle}</h3>
          <p class="text-text-secondary leading-relaxed mb-0">{t.ctaBody}</p>
        </div>
      </div>
      <a
        href={legalHref}
        class="inline-flex items-center gap-1.5 font-semibold text-primary no-underline whitespace-nowrap"
      >
        {t.ctaLink}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </Container>
</Section>
