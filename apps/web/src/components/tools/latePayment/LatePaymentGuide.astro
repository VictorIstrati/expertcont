    baseCol: "Rata de bază BNM",
    b2bCol: `Companii (+${b2b} p.p.)`,
    b2cCol: `Consumatori (+${b2c} p.p.)`,
    half: { 1: "ian.–iun.", 2: "iul.–dec." },
    ratesNote: `Sursa: istoricul ratei de bază publicat pe bnm.md, verificat la ${checked}. Calculul folosește un an de 365 de zile.`,
    letterEyebrow: "Pasul următor",
    letterTitle: "Cum folosești calculul într-o somație",
    letterSteps: [
      {
        title: "Separă datoria de dobândă",
        body: "În somație indică distinct suma principală, perioada de întârziere, dobânda sau penalitatea calculată și temeiul ei — articolul din Codul civil sau punctul din contract.",
      },
      {
        title: "Anexează calculul",
        body: "Descarcă tabelul în PDF și atașează-l, împreună cu copiile contractului, facturilor și ale actelor de predare-primire.",
      },
      {
        title: "Stabilește un termen de plată",
        body: "Acordă debitorului un termen rezonabil și precizează că dobânda continuă să curgă până la plata efectivă.",
