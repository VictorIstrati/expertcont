---
import { Container, Icon, Section } from "@expertcont/ui";
import { localeTag, type Locale } from "@expertcont/i18n";
import { LEAVE_RATES } from "./rates";
import {
  annualLeavePay,
  daysInMonth,
  forecastSalary,
  monthInfo,
  previousMonths,
  sickPay,
} from "./leaveMath";

interface Props {
  locale: Locale;
  hrHref: string;
}

const { locale, hrHref } = Astro.props;
const tag = localeTag(locale);
const nf = new Intl.NumberFormat(tag, { maximumFractionDigits: 0 });
const money = new Intl.NumberFormat(tag, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const monthFmt = new Intl.DateTimeFormat(tag, { month: "long", year: "numeric", timeZone: "UTC" });
const pct = (rate: number) => `${Math.round(rate * 100)}%`;
const mdl = (n: number) => `${money.format(n)} MDL`;
const R = LEAVE_RATES;
const year = R.year;
const cap = R.sickBaseCapMultiplier * R.averageMonthlySalary;
const previousForecast = forecastSalary(year - 1, R);

const exampleSalary = 15_000;
const leaveStart = { year, month: 7 };
const leaveMonths = previousMonths(leaveStart, R.leaveReferenceMonths).map((m) => monthInfo(m, R));
const leaveExample = annualLeavePay(
  leaveMonths.map((m) => ({
    earnings: exampleSalary,
    daysWorked: m.workingDays,
    workingDays: m.workingDays,
    calendarDays: m.calendarDays,
  })),
  14,
);
const leaveMonthNames = leaveMonths
  .map((m) => monthFmt.format(new Date(Date.UTC(m.year, m.month - 1, 1))))
  .join(", ");
const leaveStartName = monthFmt.format(new Date(Date.UTC(year, leaveStart.month - 1, 1)));

const sickStart = { year, month: 6, day: 8 };
const sickMonthDays = daysInMonth(sickStart);
const sickExample = sickPay(
  {
    start: sickStart,
    days: 10,
    incomes: Array.from({ length: R.sickBaseMonths }, () => exampleSalary),
    insurance: "over8",
    sickCase: "ordinary",
    employerDaysUsed: 0,
  },
  R,
);
const sickCnasDaily = sickExample.cnasParts[0]?.daily ?? 0;

interface Copy {
  leaveEyebrow: string;
  leaveTitle: string;
  leaveSteps: string[];
  leaveRules: string[];
  sickEyebrow: string;
  sickTitle: string;
  sickRates: { label: string; value: string }[];
  sickRules: string[];
  docsTitle: string;
  docs: string[];
  examplesEyebrow: string;
  examplesTitle: string;
  leaveExampleTitle: string;
  leaveExample: string[];
  sickExampleTitle: string;
  sickExample: string[];
  ctaTitle: string;
  ctaBody: string;
  ctaLink: string;
}

const copy: Record<Locale, Copy> = {
  ro: {
    leaveEyebrow: "Concediul de odihnă",
    leaveTitle: "Cum se calculează indemnizația de concediu",
    leaveSteps: [
      `Aduni salariul calculat în ultimele ${R.leaveReferenceMonths} luni calendaristice dinaintea concediului: salariul de bază, sporurile, primele lunare, orele suplimentare.`,
      "Împarți suma la numărul de zile lucrate efectiv în aceste luni și obții salariul mediu pe o zi lucrată.",
      "Înmulțești cu coeficientul: zilele lucrătoare după grafic împărțite la zilele calendaristice ale perioadei, fără sărbătorile nelucrătoare.",
      "Înmulțești salariul mediu pe o zi calendaristică cu numărul de zile de concediu.",
