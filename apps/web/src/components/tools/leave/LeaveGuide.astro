const t = copy[locale];
---

<Section tone="default">
  <Container>
    <div class="grid gap-8 lg:grid-cols-2 items-start">
      <div>
        <div class="eyebrow mb-4">{t.leaveEyebrow}</div>
        <h2 class="mb-6">{t.leaveTitle}</h2>
        <ol class="list-none p-0 m-0 flex flex-col gap-4">
          {
            t.leaveSteps.map((step, i) => (
              <li class="flex items-start gap-3">
                <span class="w-8 h-8 rounded-full bg-accent-50 text-accent-dark font-bold flex items-center justify-center shrink-0">
                  {i + 1}
                </span>
                <span class="text-text-secondary leading-relaxed pt-1">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="card p-6 sm:p-7">
        <ul class="list-none p-0 m-0 flex flex-col gap-3">
          {
            t.leaveRules.map((rule) => (
              <li class="flex items-start gap-2 text-sm sm:text-base">
                <span class="text-accent-dark shrink-0 mt-0.5">
                  <Icon name="check" size={18} />
                </span>
                {rule}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</Section>

<Section tone="alt">
  <Container>
    <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] items-start">
      <div>
        <div class="eyebrow mb-4">{t.sickEyebrow}</div>
        <h2 class="mb-6">{t.sickTitle}</h2>
        <dl class="card p-0 m-0 overflow-hidden">
          {
            t.sickRates.map((rate, i) => (
              <div
                class={`flex justify-between gap-4 px-6 py-4 ${i > 0 ? "border-t border-border" : ""}`}
              >
                <dt class="text-text-secondary">{rate.label}</dt>
                <dd class="m-0 font-bold text-right">{rate.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="card p-6 sm:p-7 lg:mt-[88px]">
        <ul class="list-none p-0 m-0 flex flex-col gap-3">
          {
            t.sickRules.map((rule) => (
              <li class="flex items-start gap-2 text-sm sm:text-base">
                <span class="text-primary shrink-0 mt-0.5">
                  <Icon name="check" size={18} />
                </span>
                {rule}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</Section>

<Section tone="default">
  <Container>
    <div class="text-center mb-10">
      <div class="eyebrow mb-4 justify-center">{t.examplesEyebrow}</div>
      <h2 class="mb-0">{t.examplesTitle}</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {
        [
          { title: t.leaveExampleTitle, lines: t.leaveExample, icon: "calendar" as const },
          { title: t.sickExampleTitle, lines: t.sickExample, icon: "clock" as const },
        ].map((example) => (
          <div class="card p-6 sm:p-7">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-lg bg-primary-50 text-primary flex items-center justify-center shrink-0">
                <Icon name={example.icon} size={24} />
              </div>
              <h3 class="text-lg mb-0">{example.title}</h3>
            </div>
            <ol class="m-0 pl-5 flex flex-col gap-2 text-text-secondary leading-relaxed">
              {example.lines.map((line, i) => (
                <li class={i === example.lines.length - 1 ? "font-bold text-text-primary" : ""}>
                  {line}
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </Container>
</Section>

<Section tone="alt">
