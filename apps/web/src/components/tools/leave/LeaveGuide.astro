    leaveExampleTitle: `Отпуск 14 дней с ${leaveStartName}`,
    leaveExample: [
      `Зарплата ${nf.format(exampleSalary)} MDL за ${leaveMonthNames}: ${mdl(leaveExample.totalEarnings)}.`,
      `${leaveExample.totalWorked} отработанных дней → ${mdl(leaveExample.perWorkedDay)} за отработанный день.`,
      `Коэффициент ${leaveExample.totalWorking} / ${leaveExample.totalCalendar} → ${mdl(leaveExample.perCalendarDay)} за календарный день.`,
      `Отпускные брутто: ${mdl(leaveExample.gross)}.`,
