---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import PageShell from "../../../components/PageShell.astro";
import { Container, Section, ImagePlaceholder, SectionHeader } from "@expertcont/ui";
import { detailUrl, homeUrl, sectionUrl, type Locale } from "@expertcont/i18n";
import { blogDetailProps, type BlogMeta } from "../../../lib/blogDetailProps";
import { articleJsonLd, breadcrumbListJsonLd } from "../../../lib/jsonLd";

export const getStaticPaths = (async () => {
  const metas = await getCollection("blog-meta");
  return metas.flatMap((m) =>
    m.data.uk ? [{ params: { slug: m.data.uk.slug }, props: { meta: m.data as BlogMeta } }] : [],
  );
}) satisfies GetStaticPaths;

const { meta } = Astro.props;
const uk = meta.uk!;
const chromeLocale: Locale = "ru";

const allPosts = await getCollection("blog");
const mdxEntry = allPosts.find((e) => e.data.contentId === meta.id && e.data.locale === "uk");
const { Content } = await render(mdxEntry!);

const siblings: Record<Locale, string> = {
  ro: detailUrl("blog", meta, "ro"),
  ru: detailUrl("blog", meta, "ru"),
  en: detailUrl("blog", meta, "en"),
};

const labels = {
  backToAll: "← Усі статті",
  readTimeLabel: "хв читання",
  tocLabel: "Зміст",
  similarLabel: "Схожі статті",
  continueReadingEyebrow: "Читати далі",
  continueReadingTitle: "Схожі статті",
  inlineCtaTitle: "Потрібна допомога з вашою ситуацією?",
  inlineCtaSubtitle:
    "Запишіться на консультацію з юристом ExpertCont. Консультуємо українською та російською.",
  inlineCtaButton: "Записатися на консультацію",
};

const { related, indexHref } = await blogDetailProps(meta, chromeLocale);
const serviceHref = "/ua/konsulski-posluhy";
const articlePath = `/ua/blog/${uk.slug}`;
const jsonLd = [
  articleJsonLd({
    url: articlePath,
    title: uk.title,
    description: uk.summary,
    datePublished: meta.publishedAt,
    dateModified: meta.updated,
    author: meta.author,
    locale: "uk",
    section: uk.category,
  }),
  breadcrumbListJsonLd([
    { name: "Головна", url: homeUrl(chromeLocale) },
    { name: "Блог", url: sectionUrl("blog", chromeLocale) },
    { name: uk.title, url: articlePath },
  ]),
];
---

<Base
  title={`${uk.title} — ExpertCont`}
  description={uk.summary}
  locale={chromeLocale}
  path={articlePath}
  siblings={siblings}
  jsonLd={jsonLd}
  langOverride="uk"
  extraAlternates={[{ hreflang: "uk", href: articlePath }]}
>
  <PageShell
    locale={chromeLocale}
    activeSection="blog"
    siblings={siblings}
    displayLang={{ label: "UK", full: "Українська" }}
  >
    <Section tone="default" spacing="tight">
      <Container>
        <a
          href={indexHref}
          class="mb-6 inline-flex items-center gap-2 text-sm text-text-secondary no-underline"
        >
          {labels.backToAll}
        </a>
        <div class="mb-5 flex gap-2">
          <span class="pill">{uk.category}</span>
        </div>
        <h1 class="mb-6 max-w-3xl text-[clamp(30px,4vw,48px)] leading-tight">
          {uk.title}
        </h1>
        <div class="mb-8 flex flex-wrap items-center gap-4 text-sm text-text-secondary">
          <span>{meta.publishedAt}</span>
          <span>·</span>
          <span>{meta.readTime} {labels.readTimeLabel}</span>
          {
            meta.author && (
              <>
                <span>·</span>
                <span>{meta.author}</span>
              </>
            )
          }
        </div>
        {
          meta.cover ? (
            <img
              src={meta.cover}
              alt={uk.title}
              width="2100"
              height="900"
              loading="eager"
              decoding="async"
              class="block h-auto w-full rounded-lg object-cover aspect-[21/9]"
            />
          ) : (
            <ImagePlaceholder ratio="21/9" label="Article cover" />
          )
        }
      </Container>
    </Section>

    <Section tone="default">
      <Container>
        <div class="grid grid-cols-1 gap-16 lg:grid-cols-[2fr_1fr]">
          <article class="text-lg leading-relaxed text-text-primary">
            <Content />
            <div class="mt-12 rounded-lg bg-primary p-8 text-white">
              <h3 class="mb-3 text-white">{labels.inlineCtaTitle}</h3>
              <p class="mb-5 text-white/80">{labels.inlineCtaSubtitle}</p>
              <a
                href={serviceHref}
                class="btn btn-primary inline-flex items-center gap-2 no-underline"
              >
                {labels.inlineCtaButton}
              </a>
            </div>
          </article>

          <aside class="hidden flex-col gap-6 lg:flex">
            {
              related.length > 0 && (
                <div class="card sticky top-nav-h p-6">
                  <div class="mb-4 text-xs font-bold uppercase tracking-widest text-text-secondary">
                    {labels.similarLabel}
                  </div>
                  <div class="flex flex-col gap-3">
                    {related.map((p) => (
                      <a href={p.href} class="block no-underline">
                        <div class="card-flat p-4">
                          <span class="pill pill-soft mb-2 inline-block">{p.category}</span>
                          <div class="mt-1 mb-2 text-sm font-semibold leading-snug text-text-primary">
                            {p.title}
                          </div>
                          <div class="text-xs text-text-secondary">
                            {p.date} · {p.readTime} {labels.readTimeLabel}
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              )
            }
          </aside>
        </div>
      </Container>
    </Section>

    {
      related.length > 0 && (
        <Section tone="alt">
          <Container>
            <SectionHeader
              eyebrow={labels.continueReadingEyebrow}
              title={labels.continueReadingTitle}
            />
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((p) => (
                <article>
                  <a href={p.href} class="card card-hover block overflow-hidden p-0 no-underline">
                    {p.cover ? (
                      <img
                        src={p.cover}
                        alt={p.title}
                        width="1600"
                        height="1000"
                        loading="lazy"
                        decoding="async"
                        class="block h-full w-full object-cover aspect-[16/10]"
                      />
                    ) : (
                      <ImagePlaceholder ratio="16/10" label={p.category} />
                    )}
                    <div class="p-6">
                      <span class="pill pill-soft mb-3 inline-block">{p.category}</span>
                      <h3 class="mt-2 mb-3 text-lg leading-snug text-text-primary">{p.title}</h3>
                      <div class="text-xs text-text-secondary">
                        {p.date} · {p.readTime} {labels.readTimeLabel}
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </Container>
        </Section>
      )
    }
  </PageShell>
</Base>
