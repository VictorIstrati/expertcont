---
import Base from "../../layouts/Base.astro";
import PageShell from "../../components/PageShell.astro";
import { Container, PageHeader, Section } from "@expertcont/ui";
import { homeUrl, sectionUrl, serviceDetailUrl, type Locale } from "@expertcont/i18n";
import { LeaveCalculator } from "../../components/tools/leave/LeaveCalculator";
import LeaveGuide from "../../components/tools/leave/LeaveGuide.astro";
import { getTool, toolSiblings, toolUrl } from "../../components/tools/tools";
import { ServiceCTAStrip } from "../../components/service/ServiceCTAStrip";
import { breadcrumbListJsonLd } from "../../lib/jsonLd";

const locale: Locale = "ro";
const tool = getTool("leave-calculator");
const siblings = toolSiblings(tool);
const path = toolUrl(tool, locale);
const hubHref = sectionUrl("tools", locale);
const contactHref = sectionUrl("contact", locale);
const hrHref = serviceDetailUrl("hr", locale);

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://expertcont.md";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: tool.title[locale],
    description: tool.description[locale],
    url: `${siteUrl}${path}`,
    inLanguage: locale,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: 0, priceCurrency: "MDL" },
  },
  breadcrumbListJsonLd([
    { name: "Acasă", url: homeUrl(locale) },
    { name: "Instrumente gratuite", url: hubHref },
    { name: tool.title[locale], url: path },
  ]),
];
---

<Base
  title="Calculator concediu de odihnă și medical 2026 · gratuit — ExpertCont"
  description="Calculează gratuit indemnizația de concediu de odihnă și concediul medical în Moldova: salariul mediu, zilele plătite de angajator și de CNAS, suma netă."
  locale={locale}
  path={path}
  siblings={siblings}
  jsonLd={jsonLd}
>
  <PageShell locale={locale} siblings={siblings}>
    <PageHeader
      eyebrow="Instrumente gratuite"
      title="Cât primești pentru concediu sau boală?"
      subtitle="Introdu salariile din ultimele luni și zilele de concediu — vezi indemnizația brută, partea angajatorului, partea CNAS și suma netă."
      breadcrumbs={[
        { label: "Acasă", href: homeUrl(locale) },
        { label: "Instrumente gratuite", href: hubHref },
        { label: tool.title[locale] },
      ]}
    />

    <LeaveCalculator client:visible locale={locale} hrHref={hrHref} />

    <LeaveGuide locale={locale} hrHref={hrHref} />

    <Section tone="default">
      <Container>
        <ServiceCTAStrip client:visible locale={locale} contactHref={contactHref} />
      </Container>
    </Section>
  </PageShell>
</Base>
