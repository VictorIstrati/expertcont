---
import Base from "../../../layouts/Base.astro";
import PageShell from "../../../components/PageShell.astro";
import { Container, PageHeader, Section } from "@expertcont/ui";
import { homeUrl, sectionUrl, type Locale } from "@expertcont/i18n";
import { InvoiceGenerator } from "../../../components/tools/invoice/InvoiceGenerator";
import InvoiceGuide from "../../../components/tools/invoice/InvoiceGuide.astro";
import { getTool, toolSiblings, toolUrl } from "../../../components/tools/tools";
import { ServiceCTAStrip } from "../../../components/service/ServiceCTAStrip";
import { breadcrumbListJsonLd } from "../../../lib/jsonLd";

const locale: Locale = "ru";
const tool = getTool("invoice-generator");
const siblings = toolSiblings(tool);
const path = toolUrl(tool, locale);
const hubHref = sectionUrl("tools", locale);
const contactHref = sectionUrl("contact", locale);

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://expertcont.md";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: tool.title[locale],
    description: tool.description[locale],
    url: `${siteUrl}${path}`,
    inLanguage: locale,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: 0, priceCurrency: "MDL" },
  },
  breadcrumbListJsonLd([
    { name: "Главная", url: homeUrl(locale) },
    { name: "Бесплатные инструменты", url: hubHref },
    { name: tool.title[locale], url: path },
  ]),
];
---

<Base
  title="Бесплатный генератор инвойсов для зарубежных клиентов · PDF — ExpertCont"
  description="Бесплатный генератор инвойсов для зарубежных клиентов и проформ для любой компании в Молдове: английский, румынский или русский, EUR, USD или MDL, сумма прописью, PDF без регистрации."
  locale={locale}
  path={path}
  siblings={siblings}
  jsonLd={jsonLd}
>
  <PageShell locale={locale} siblings={siblings}>
    <PageHeader
      eyebrow="Бесплатные инструменты"
      title="Бесплатный генератор инвойсов для зарубежных клиентов"
      subtitle="Для любой компании в Молдове, плательщика НДС или нет. Заполните данные, сразу посмотрите счёт и скачайте PDF — без регистрации."
      breadcrumbs={[
        { label: "Главная", href: homeUrl(locale) },
        { label: "Бесплатные инструменты", href: hubHref },
        { label: tool.title[locale] },
      ]}
    />

    <InvoiceGenerator client:load locale={locale} />

    <InvoiceGuide locale={locale} />

    <Section tone="default">
      <Container>
        <ServiceCTAStrip client:visible locale={locale} contactHref={contactHref} />
      </Container>
    </Section>
  </PageShell>
</Base>
