---
import Base from "../layouts/Base.astro";
import PageShell from "../components/PageShell.astro";
import LegalIsland from "../components/legal/LegalIsland";
import { sectionUrl, type Locale } from "@expertcont/i18n";

const locale: Locale = "ro";
const kind = "dataProtection" as const;
const path = sectionUrl("dataProtection", locale);
const siblings: Record<Locale, string> = {
  ro: sectionUrl("dataProtection", "ro"),
  ru: sectionUrl("dataProtection", "ru"),
  en: sectionUrl("dataProtection", "en"),
};
---

<Base
  title="Politica privind datele personale — ExpertCont"
  description="Modul în care SRL „Right Consult Company” (ExpertCont) prelucrează datele cu caracter personal în calitate de operator: scopuri, temeiuri juridice, destinatari, termene de stocare și drepturile persoanelor vizate conform Legii nr. 195/2024."
  locale={locale}
  path={path}
  siblings={siblings}
>
  <PageShell locale={locale} siblings={siblings}>
    <LegalIsland
      client:visible
      locale={locale}
      kind={kind}
      contactHref={sectionUrl("contact", locale)}
    />
  </PageShell>
</Base>
